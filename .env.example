KESTIV_KEYPAIR_PATH=~/.config/kestiv/keypair.json
FOUNDER_WALLET=
KESTIV_MINT=
CLAWPUMP_API_KEY=
HELIUS_API_KEY=
JUPITER_API_KEY=
USEPOD_MODEL=deepseek-v4-flash
STATUS_PORT=8787
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=

# Agent: address of Kestiv's wallet (public key, used by dry runs and status)
KESTIV_WALLET=

# Web app (Vercel), server-side only. Never prefix these with NEXT_PUBLIC_.
# HELIUS_API_KEY (above) is also used by web for chain reads.
# SOLANA_CLUSTER (above) selects mainnet-beta or devnet for web.
# KESTIV_MINT (above): leave unset until the token is live, web shows "not launched".
# KESTIV_WALLET and FOUNDER_WALLET (above) identify the vesting contract sender and recipient.
# Base URL of `kestiv serve-status` as reachable from Vercel (for example a tunnel), no trailing slash. Optional.
KESTIV_STATUS_URL=
# Public GitHub repository URL. When set, the web footer shows a GitHub link. Optional.
KESTIV_REPO_URL=
